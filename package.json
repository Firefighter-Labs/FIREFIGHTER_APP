{
  "name": "firefighter",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-http-header-size=65536 vite",
    "build": "tsc -b && vite build",
    "preview": "cross-env NODE_OPTIONS=--max-http-header-size=65536 vite preview",
    "cap:init": "cap add ios",
    "cap:sync": "npm run build && cap sync ios",
    "cap:open": "cap open ios"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.2.0",
    "@capacitor/core": "^7.2.0",
    "@capacitor/ios": "^7.2.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "cross-env": "^7.0.3",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
